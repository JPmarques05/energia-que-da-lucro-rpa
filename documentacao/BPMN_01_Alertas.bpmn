<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Alertas" targetNamespace="https://energia-que-da-lucro.example/bpmn"><bpmn:process id="Process_Alertas" name="BPMN 01 - Alertas de desperdício" isExecutable="false"><bpmn:startEvent id="start" name="Início agendado a cada 5 minutos"><bpmn:timerEventDefinition id="Timer_Agendado" /></bpmn:startEvent><bpmn:task id="recover" name="Recuperar registros pendentes e cargas em andamento" /><bpmn:task id="read" name="Ler eventos.json e lojas.json e validar a estrutura" /><bpmn:exclusiveGateway id="fileok" name="Arquivos válidos?" /><bpmn:task id="fatal" name="Registrar falha de leitura ou arquivo inválido" /><bpmn:endEvent id="endfail" name="Encerrar execução com falha" /><bpmn:exclusiveGateway id="next" name="Há próximo evento?" /><bpmn:exclusiveGateway id="advance" name="Continuar lote" /><bpmn:task id="finish" name="Consolidar auditoria da execução" /><bpmn:endEvent id="end" name="Fim da execução" /><bpmn:task id="validate" name="Selecionar e validar evento: ID, loja, tipo, início e duração" /><bpmn:exclusiveGateway id="valid" name="Evento válido?" /><bpmn:task id="invalid" name="Registrar evento inválido e motivo" /><bpmn:exclusiveGateway id="eligible" name="Porta aberta &gt; 60 s e dentro do horário?" /><bpmn:task id="skip" name="Registrar evento ignorado e motivo" /><bpmn:exclusiveGateway id="duplicate" name="Evento já possui estado de envio?" /><bpmn:task id="duplog" name="Registrar duplicidade ou pendência" /><bpmn:task id="reserve" name="Persistir reserva de envio pelo ID do evento" /><bpmn:exclusiveGateway id="reserveok" name="Reserva salva?" /><bpmn:task id="resfail" name="Registrar falha de persistência; não enviar" /><bpmn:sendTask id="send" name="Enviar alerta pelo Telegram" /><bpmn:exclusiveGateway id="result" name="Resultado do envio?" /><bpmn:task id="ok" name="Salvar envio confirmado e mensagem no arquivo de saída" /><bpmn:exclusiveGateway id="writeok" name="Resultado persistido?" /><bpmn:task id="pending" name="Manter registro pendente; recuperar sem reenviar" /><bpmn:exclusiveGateway id="retry" name="Falha transitória certa e tentativas &lt; 3?" /><bpmn:intermediateCatchEvent id="wait" name="Aguardar antes de nova tentativa"><bpmn:timerEventDefinition id="Timer_Espera" /></bpmn:intermediateCatchEvent><bpmn:task id="failed" name="Registrar falha definitiva e liberar próximo evento" /><bpmn:task id="uncertain" name="Marcar envio como incerto; revisar antes de reenviar" /><bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="recover" /><bpmn:sequenceFlow id="Flow_1" sourceRef="recover" targetRef="read" /><bpmn:sequenceFlow id="Flow_2" sourceRef="read" targetRef="fileok" /><bpmn:sequenceFlow id="Flow_3" sourceRef="fileok" targetRef="fatal" name="Não" /><bpmn:sequenceFlow id="Flow_4" sourceRef="fatal" targetRef="endfail" /><bpmn:sequenceFlow id="Flow_5" sourceRef="fileok" targetRef="next" name="Sim" /><bpmn:sequenceFlow id="Flow_6" sourceRef="next" targetRef="finish" name="Não" /><bpmn:sequenceFlow id="Flow_7" sourceRef="finish" targetRef="end" /><bpmn:sequenceFlow id="Flow_8" sourceRef="next" targetRef="validate" name="Sim" /><bpmn:sequenceFlow id="Flow_9" sourceRef="validate" targetRef="valid" /><bpmn:sequenceFlow id="Flow_10" sourceRef="valid" targetRef="invalid" name="Não" /><bpmn:sequenceFlow id="Flow_11" sourceRef="invalid" targetRef="advance" /><bpmn:sequenceFlow id="Flow_12" sourceRef="valid" targetRef="eligible" name="Sim" /><bpmn:sequenceFlow id="Flow_13" sourceRef="eligible" targetRef="skip" name="Não" /><bpmn:sequenceFlow id="Flow_14" sourceRef="skip" targetRef="advance" /><bpmn:sequenceFlow id="Flow_15" sourceRef="eligible" targetRef="duplicate" name="Sim" /><bpmn:sequenceFlow id="Flow_16" sourceRef="duplicate" targetRef="duplog" name="Sim" /><bpmn:sequenceFlow id="F