<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Resumos" targetNamespace="https://energia-que-da-lucro.example/bpmn"><bpmn:process id="Process_Resumos" name="BPMN 02 - Resumos de desperdício" isExecutable="false"><bpmn:startEvent id="start" name="Início: agenda semanal ou mensal"><bpmn:timerEventDefinition id="Timer_Agendado" /></bpmn:startEvent><bpmn:task id="period" name="Definir período encerrado e tipo de resumo" /><bpmn:task id="recover" name="Recuperar registros pendentes sem reenviar mensagens" /><bpmn:task id="read" name="Ler e validar lojas.json, resumos.json e recomendacoes.json" /><bpmn:exclusiveGateway id="fileok" name="Arquivos válidos?" /><bpmn:task id="fatal" name="Registrar erro de leitura ou estrutura inválida" /><bpmn:endEvent id="endfail" name="Encerrar execução com falha" /><bpmn:exclusiveGateway id="next" name="Há próxima loja?" /><bpmn:exclusiveGateway id="advance" name="Continuar lote" /><bpmn:task id="finish" name="Consolidar auditoria da execução" /><bpmn:endEvent id="end" name="Fim da execução" /><bpmn:task id="validate" name="Selecionar loja e obter resumo para o período" /><bpmn:exclusiveGateway id="valid" name="Loja, destinatário e resumo válidos?" /><bpmn:task id="invalid" name="Registrar dados ausentes ou inválidos da loja" /><bpmn:exclusiveGateway id="duplicate" name="Já existe estado de envio para loja e período?" /><bpmn:task id="duplog" name="Registrar duplicidade ou envio pendente" /><bpmn:exclusiveGateway id="recommend" name="Recomendação disponível?" /><bpmn:task id="norec" name="Registrar ausência e indicar indisponibilidade no e-mail" /><bpmn:task id="compose" name="Montar e-mail com período, totais, equipamentos e sugestões" /><bpmn:task id="reserve" name="Persistir reserva por loja, periodicidade e período" /><bpmn:exclusiveGateway id="reserveok" name="Reserva salva?" /><bpmn:task id="resfail" name="Registrar falha de persistência; não enviar" /><bpmn:sendTask id="send" name="Enviar resumo por e-mail" /><bpmn:exclusiveGateway id="result" name="Resultado do envio?" /><bpmn:task id="ok" name="Salvar envio confirmado no arquivo de saída" /><bpmn:exclusiveGateway id="writeok" name="Resultado persistido?" /><bpmn:task id="pending" name="Manter registro pendente; recuperar sem reenviar" /><bpmn:exclusiveGateway id="retry" name="Falha transitória certa e tentativas &lt; 3?" /><bpmn:intermediateCatchEvent id="wait" name="Aguardar antes de nova tentativa"><bpmn:timerEventDefinition id="Timer_Espera" /></bpmn:intermediateCatchEvent><bpmn:task id="failed" name="Registrar falha definitiva do envio" /><bpmn:task id="uncertain" name="Marcar envio como incerto; revisar antes de reenviar" /><bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="period" /><bpmn:sequenceFlow id="Flow_1" sourceRef="period" targetRef="recover" /><bpmn:sequenceFlow id="Flow_2" sourceRef="recover" targetRef="read" /><bpmn:sequenceFlow id="Flow_3" sourceRef="read" targetRef="fileok" /><bpmn:sequenceFlow id="Flow_4" sourceRef="fileok" targetRef="fatal" name="Não" /><bpmn:sequenceFlow id="Flow_5" sourceRef="fatal" targetRef="endfail" /><bpmn:sequenceFlow id="Flow_6" sourceRef="fileok" targetRef="next" name="Sim" /><bpmn:sequenceFlow id="Flow_7" sourceRef="next" targetRef="finish" name="Não" /><bpmn:sequenceFlow id="Flow_8" sourceRef="finish" targetRef="end" /><bpmn:sequenceFlow id="Flow_9" sourceRef="next" targetRef="validate" name="Sim" /><bpmn:sequenceFlow id="Flow_10" sourceRef="validate" targetRef="valid" /><bpmn:sequenceFlow id="Flow_11" sourceRef="valid" targetRef="invalid" name="Não" /><bpmn:sequenceFlow id="Flow_12" sourceRef="invalid" targetRef="advance" /><bpmn:sequenceFlow id="Flow_13" sourceRef="valid" targetRef="duplicate" name="Sim" /><bpmn:sequenceFlow id="Flow_14" sourceRef="duplicate" targetRef="duplog" name="Sim" />